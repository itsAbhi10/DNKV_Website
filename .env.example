# ========================================================
# Dr. Netaji Karale Vidyalaya (DNKV) - Environment Variables
# ========================================================

# --- Database (PostgreSQL via Neon / Local / Supabase) ---
DATABASE_URI=postgresql://postgres@localhost:5433/dnkv

# --- Payload CMS Security ---
PAYLOAD_SECRET=your-secure-random-payload-secret-at-least-32-chars-long
SERVER_URL=http://localhost:3001
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# --- Frontend Application ---
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# --- On-Demand Live Revalidation Secret ---
REVALIDATION_SECRET=dnkv_secure_revalidation_secret_token_2026

# --- Object Storage (Cloudflare R2 / AWS S3 / Vercel Blob) ---
# Set S3_ENABLED=true for AWS S3 or Cloudflare R2
S3_ENABLED=false
S3_BUCKET=dnkv-media
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
# For Vercel Blob:
BLOB_READ_WRITE_TOKEN=

# --- Email Notifications (Resend / SMTP) ---
RESEND_API_KEY=
EMAIL_FROM=admissions@dnkv.in
ENQUIRY_NOTIFICATION_EMAIL=dnkvchinchgaon@gmail.com

# --- Hero Video API (Optional - KenBurns provider is built-in without API) ---
VIDEO_API_URL=
VIDEO_API_KEY=
